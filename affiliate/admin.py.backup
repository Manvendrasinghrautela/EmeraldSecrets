# AFFILIATE CLICK ADMIN
# ============================================================================

@admin.register(AffiliateClick)
class AffiliateClickAdmin(admin.ModelAdmin):
    list_display = ('affiliate_code', 'visitor_id', 'ip_address', 'created_at')
    list_filter = ('affiliate', 'created_at')
    search_fields = ('affiliate__affiliate_code', 'visitor_id', 'ip_address')
    readonly_fields = ('affiliate', 'visitor_id', 'ip_address', 'user_agent', 'referrer_url', 'session_key', 'created_at')
    date_hierarchy = 'created_at'

    fieldsets = (
        ('Click Information', {
            'fields': ('affiliate', 'visitor_id', 'ip_address')
        }),
        ('Technical Details', {
            'fields': ('user_agent', 'referrer_url', 'session_key'),
            'classes': ('collapse',)
        }),
        ('Timestamp', {
            'fields': ('created_at',),
        }),
    )

    def affiliate_code(self, obj):
        """Display affiliate code"""
        return obj.affiliate.affiliate_code

    affiliate_code.short_description = 'Affiliate'
    affiliate_code.admin_order_field = 'affiliate__affiliate_code'

    def has_add_permission(self, request):
        """Disable adding clicks manually"""
        return False

    def has_delete_permission(self, request, obj=None):
        """Only superuser can delete"""
        return request.user.is_superuser


# ============================================================================
# AFFILIATE ORDER ADMIN
# ============================================================================

@admin.register(AffiliateOrder)
class AffiliateOrderAdmin(admin.ModelAdmin):
    list_display = (
        'affiliate_code',
        'order_number',
        'order_amount_display',
        'commission_display',
        'status',
        'created_at'
    )

    list_filter = ('status', 'created_at', 'affiliate')
    search_fields = ('affiliate__affiliate_code', 'order__order_number')
    date_hierarchy = 'created_at'
    readonly_fields = ('created_at', 'confirmed_at', 'completed_at')

    fieldsets = (
        ('Order Information', {
            'fields': ('affiliate', 'order')
        }),
        ('Commission Details', {
            'fields': ('order_amount', 'commission_rate', 'commission_amount')
        }),
        ('Status', {
            'fields': ('status',)
        }),
        ('Timestamps', {
            'fields': ('created_at', 'confirmed_at', 'completed_at'),
            'classes': ('collapse',)
        }),
    )

    actions = ['confirm_orders', 'complete_orders', 'cancel_orders']

    def affiliate_code(self, obj):
        """Display affiliate code"""
        return obj.affiliate.affiliate_code

    affiliate_code.short_description = 'Affiliate'
    affiliate_code.admin_order_field = 'affiliate__affiliate_code'

    def order_number(self, obj):
        """Display order number"""
        return obj.order.order_number if obj.order else 'N/A'

    order_number.short_description = 'Order #'

    def order_amount_display(self, obj):
        """Display order amount"""
        return format_html('₹{:.2f}', obj.order_amount)

    order_amount_display.short_description = 'Order Amount'
    order_amount_display.admin_order_field = 'order_amount'

    def commission_display(self, obj):
        """Display commission with color and percentage"""
        return format_html(
            '<span style="color: green; font-weight: bold;">₹{:.2f}</span><br><small>({}%)</small>',
            obj.commission_amount,
            obj.commission_rate
        )

    commission_display.short_description = 'Commission'
    commission_display.admin_order_field = 'commission_amount'

    def confirm_orders(self, request, queryset):
        """Confirm selected orders"""
        count = 0
        for order in queryset.filter(status='pending'):
            order.confirm()
            count += 1
        self.message_user(request, f'✅ {count} orders confirmed!')
        logger.info(f"Admin {request.user.username} confirmed {count} affiliate orders")

    confirm_orders.short_description = "✅ Confirm orders"

    def complete_orders(self, request, queryset):
        """Complete selected orders and add commissions"""
        count = 0
        for order in queryset.filter(status__in=['pending', 'confirmed']):
            order.complete()
            count += 1
        self.message_user(request, f'✅ {count} orders completed and commissions added!')
        logger.info(f"Admin {request.user.username} completed {count} affiliate orders")

    complete_orders.short_description = "✅ Complete orders (add commission)"

    def cancel_orders(self, request, queryset):
        """Cancel selected orders"""
        count = 0
        for order in queryset.filter(status__in=['pending', 'confirmed', 'completed']):
            order.cancel()
            count += 1
        self.message_user(request, f'❌ {count} orders cancelled and commissions revoked!')
        logger.info(f"Admin {request.user.username} cancelled {count} affiliate orders")

    cancel_orders.short_description = "❌ Cancel orders (revoke commission)"


# ============================================================================
# AFFILIATE WITHDRAWAL ADMIN
# ============================================================================

@admin.register(AffiliateWithdrawal)
class AffiliateWithdrawalAdmin(admin.ModelAdmin):
    list_display = (
        'affiliate_username',
        'amount_display',
        'payment_method',
        'status',
        'requested_at',
        'paid_at'
    )

    list_filter = ('status', 'payment_method', 'requested_at')
    search_fields = ('affiliate__user__username', 'affiliate__affiliate_code', 'transaction_id')
    date_hierarchy = 'requested_at'
    readonly_fields = ('requested_at', 'approved_at', 'paid_at')

    fieldsets = (
        ('Withdrawal Request', {
            'fields': ('affiliate', 'amount', 'status')
        }),
        ('Payment Details', {
            'fields': ('payment_method', 'payment_details', 'transaction_id')
        }),
        ('Admin Notes', {
            'fields': ('admin_notes',)
        }),
        ('Processing History', {
            'fields': ('requested_at', 'approved_at', 'paid_at'),
            'classes': ('collapse',)
        }),
    )

    actions = ['approve_withdrawals', 'mark_as_processing', 'mark_as_paid', 'reject_withdrawals']

    def affiliate_username(self, obj):
        """Display affiliate username"""
        return obj.affiliate.user.username

    affiliate_username.short_description = 'Affiliate'
    affiliate_username.admin_order_field = 'affiliate__user__username'

    def amount_display(self, obj):
        """Display amount with color based on status"""
        colors = {
            'pending': '#FFA500',
            'approved': '#4169E1',
            'processing': '#800080',
            'paid': '#228B22',
            'rejected': '#DC143C'
        }
        color = colors.get(obj.status, '#000000')
        return format_html(
            '<span style="color: {}; font-weight: bold;">₹{:.2f}</span>',
            color,
            obj.amount
        )

    amount_display.short_description = 'Amount'
    amount_display.admin_order_field = 'amount'

    def approve_withdrawals(self, request, queryset):
        """Approve selected withdrawals"""
        updated = queryset.filter(status='pending').update(
            status='approved',
            approved_at=timezone.now()
        )
        self.message_user(request, f'✅ {updated} withdrawals approved!')
        logger.info(f"Admin {request.user.username} approved {updated} withdrawals")

    approve_withdrawals.short_description = "✅ Approve withdrawals"

    def mark_as_processing(self, request, queryset):
        """Mark withdrawals as processing"""
        updated = queryset.filter(status='approved').update(status='processing')
        self.message_user(request, f'⏳ {updated} withdrawals marked as processing!')
        logger.info(f"Admin {request.user.username} marked {updated} withdrawals as processing")

    mark_as_processing.short_description = "⏳ Mark as processing"

    def mark_as_paid(self, request, queryset):
        """Mark withdrawals as paid"""
        count = 0
        for withdrawal in queryset.filter(status__in=['pending', 'approved', 'processing']):
            withdrawal.mark_paid()
            count += 1
        self.message_user(request, f'✅ {count} withdrawals marked as paid!')
        logger.info(f"Admin {request.user.username} marked {count} withdrawals as paid")

    mark_as_paid.short_description = "✅ Mark as paid"

    def reject_withdrawals(self, request, queryset):
        """Reject selected withdrawals"""
        updated = queryset.filter(status__in=['pending', 'approved']).update(status='rejected')
        self.message_user(request, f'❌ {updated} withdrawals rejected!')
        logger.info(f"Admin {request.user.username} rejected {updated} withdrawals")

    reject_withdrawals.short_description = "❌ Reject withdrawals"


# ============================================================================
# AFFILIATE TRANSACTION ADMIN
# ============================================================================

@admin.register(AffiliateTransaction)
class AffiliateTransactionAdmin(admin.ModelAdmin):
    list_display = (
        'affiliate_code',
        'transaction_type',
        'amount_display',
        'description_short',
        'balance_after_display',
        'created_at'
    )

    list_filter = ('transaction_type', 'created_at', 'affiliate')
    search_fields = ('affiliate__affiliate_code', 'description')
    date_hierarchy = 'created_at'
    readonly_fields = ('affiliate', 'transaction_type', 'amount', 'description', 'related_order', 'related_withdrawal', 'balance_after', 'created_at')

    fieldsets = (
        ('Transaction Details', {
            'fields': ('affiliate', 'transaction_type', 'amount', 'description')
        }),
        ('Related Objects', {
            'fields': ('related_order', 'related_withdrawal'),
            'classes': ('collapse',)
        }),
        ('Balance', {
            'fields': ('balance_after',)
        }),
        ('Timestamp', {
            'fields': ('created_at',),
        }),
    )

    def affiliate_code(self, obj):
        """Display affiliate code"""
        return obj.affiliate.affiliate_code

    affiliate_code.short_description = 'Affiliate'
    affiliate_code.admin_order_field = 'affiliate__affiliate_code'

    def amount_display(self, obj):
        """Display amount with color based on type"""
        color = 'green' if obj.transaction_type in ['earning', 'bonus'] else 'red'
        return format_html(
            '<span style="color: {}; font-weight: bold;">₹{:.2f}</span>',
            color,
            obj.amount
        )

    amount_display.short_description = 'Amount'
    amount_display.admin_order_field = 'amount'

    def balance_after_display(self, obj):
        """Display balance after transaction"""
        return format_html('₹{:.2f}', obj.balance_after)

    balance_after_display.short_description = 'Balance After'
    balance_after_display.admin_order_field = 'balance_after'

    def description_short(self, obj):
        """Display short description"""
        return obj.description[:50] + '...' if len(obj.description) > 50 else obj.description

    description_short.short_description = 'Description'

    def has_add_permission(self, request):
        """Disable adding transactions manually - auto-created only"""
        return False

    def has_delete_permission(self, request, obj=None):
        """Only superuser can delete"""
        return request.user.is_superuser


# ============================================================================
# AFFILIATE BANNER ADMIN
# ============================================================================

@admin.register(AffiliateBanner)
class AffiliateBannerAdmin(admin.ModelAdmin):
    list_display = ('title', 'size', 'banner_preview', 'is_active', 'created_at')
    list_filter = ('size', 'is_active', 'created_at')
    search_fields = ('title', 'alt_text')
    list_editable = ('is_active',)
    date_hierarchy = 'created_at'
    readonly_fields = ('created_at', 'banner_preview')

    fieldsets = (
        ('Banner Details', {
            'fields': ('title', 'size', 'is_active')
        }),
        ('Image & Preview', {
            'fields': ('image', 'banner_preview', 'alt_text')
        }),
        ('Link', {
            'fields': ('link_url',)
        }),
        ('Timestamp', {
            'fields': ('created_at',),
            'classes': ('collapse',)
        }),
    )

    def banner_preview(self, obj):
        """Display banner preview"""
        if obj.image:
            return format_html(
                '<img src="{}" style="max-width: 300px; max-height: 200px; border: 1px solid #ddd; padding: 5px;">',
                obj.image.url
            )
        return 'No image uploaded'

    banner_preview.short_description = 'Preview'
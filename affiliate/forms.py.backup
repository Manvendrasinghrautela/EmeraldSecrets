    def clean_ifsc_code(self):
        """Validate IFSC code"""
        ifsc_code = self.cleaned_data.get('ifsc_code')
        if ifsc_code:
            ifsc_code = ifsc_code.upper().replace(' ', '')
            if len(ifsc_code) != 11:
                raise ValidationError("IFSC code must be exactly 11 characters.")
            if not (ifsc_code[:4].isalpha() and ifsc_code[4] == '0' and ifsc_code[5:].isalnum()):
                raise ValidationError("Invalid IFSC code format.")
        return ifsc_code

    def clean_pan_number(self):
        """Validate PAN number"""
        pan = self.cleaned_data.get('pan_number')
        if pan:
            pan = pan.upper().replace(' ', '')
            if len(pan) != 10:
                raise ValidationError("PAN must be exactly 10 characters.")
            if not (pan[:5].isalpha() and pan[5:9].isdigit() and pan[9].isalpha()):
                raise ValidationError("Invalid PAN format.")
        return pan

    def clean_upi_id(self):
        """Validate UPI ID"""
        upi_id = self.cleaned_data.get('upi_id')
        if upi_id:
            if '@' not in upi_id:
                raise ValidationError("UPI ID must be in format: username@bankname")
            parts = upi_id.split('@')
            if len(parts) != 2 or not parts[0] or not parts[1]:
                raise ValidationError("Invalid UPI ID format.")
        return upi_id

    def clean(self):
        """Overall form validation"""
        cleaned_data = super().clean()
        
        # At least one payment method must be filled
        account_number = cleaned_data.get('account_number')
        upi_id = cleaned_data.get('upi_id')
        
        if not account_number and not upi_id:
            raise ValidationError(
                "Please provide either a Bank Account Number or UPI ID for withdrawals."
            )
        
        return cleaned_data
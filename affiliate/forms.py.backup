from django import forms
from django.core.exceptions import ValidationError
from .models import AffiliateApplication, AffiliateWithdrawal, AffiliateUser


# ============================================================================
# AFFILIATE APPLICATION FORM - For new affiliates applying to program
# ============================================================================

class AffiliateApplicationForm(forms.Form):
    """Form for new affiliate application with bank details"""
    
    # Application Details
    why_interested = forms.CharField(
        label="Why do you want to join our affiliate program?",
        max_length=500,
        widget=forms.Textarea(attrs={
            'class': 'form-control',
            'placeholder': 'Tell us about your promotional channels and audience...',
            'rows': 4
        }),
        help_text="Describe your website, blog, YouTube channel, or social media presence"
    )
    
    website_url = forms.URLField(
        label="Your Website/Blog URL (Optional)",
        required=False,
        widget=forms.URLInput(attrs={
            'class': 'form-control',
            'placeholder': 'https://yourwebsite.com'
        })
    )
    
    # Bank Details - Required for payouts
    bank_name = forms.CharField(
        label="Bank Name",
        max_length=100,
        widget=forms.TextInput(attrs={
            'class': 'form-control',
            'placeholder': 'e.g., State Bank of India, HDFC Bank',
        }),
        help_text="Name of your bank"
    )
    
    account_holder_name = forms.CharField(
        label="Account Holder Name",
        max_length=200,
        widget=forms.TextInput(attrs={
            'class': 'form-control',
            'placeholder': 'Name exactly as shown in bank account',
        }),
        help_text="Must match your bank records exactly"
    )
    
    account_number = forms.CharField(
        label="Account Number",
        max_length=20,
        widget=forms.TextInput(attrs={
            'class': 'form-control',
            'placeholder': 'e.g., 1234567890123456',
        }),
        help_text="Your bank account number (usually 9-18 digits)"
    )
    
    ifsc_code = forms.CharField(
        label="IFSC Code",
        max_length=11,
        widget=forms.TextInput(attrs={
            'class': 'form-control',
            'placeholder': 'e.g., SBIN0001234',
        }),
        help_text="11-character IFSC code of your bank branch"
    )
    
    upi_id = forms.CharField(
        label="UPI ID (Optional)",
        max_length=255,
        required=False,
        widget=forms.TextInput(attrs={
            'class': 'form-control',
            'placeholder': 'yourname@okhdfcbank',
        }),
        help_text="For faster transfers (e.g., yourname@bankname)"
    )
    
    pan_number = forms.CharField(
        label="PAN Number (Recommended for tax purposes)",
        max_length=10,
        required=False,
        widget=forms.TextInput(attrs={
            'class': 'form-control',
            'placeholder': 'ABCDE1234F',
        }),
        help_text="10-character PAN for income tax purposes"
    )
    
    # Agreement
    agree_terms = forms.BooleanField(
        label="I agree to the Affiliate Program Terms & Conditions",
        required=True,
        widget=forms.CheckboxInput(attrs={
            'class': 'form-check-input'
        })
    )

    def clean_account_number(self):
        """Validate account number"""
        account_number = self.cleaned_data.get('account_number')
        if account_number:
            # Remove spaces
            account_number = account_number.replace(' ', '')
            
            if not account_number.isdigit():
                raise ValidationError("Account number must contain only digits.")
            
            if len(account_number) < 9 or len(account_number) > 18:
                raise ValidationError("Account number must be 9-18 digits long.")
        
        return account_number

    def clean_ifsc_code(self):
        """Validate IFSC code format"""
        ifsc_code = self.cleaned_data.get('ifsc_code')
        if ifsc_code:
            ifsc_code = ifsc_code.upper().replace(' ', '')
            
            if len(ifsc_code) != 11:
                raise ValidationError("IFSC code must be exactly 11 characters.")
            
            # Format: 4 letters + 1 zero + 6 alphanumeric
            if not (ifsc_code[:4].isalpha() and ifsc_code[4] == '0' and ifsc_code[5:].isalnum()):
                raise ValidationError("Invalid IFSC code format. Expected format: ABCD0123456")
        
        return ifsc_code

    def clean_pan_number(self):
        """Validate PAN format"""
        pan = self.cleaned_data.get('pan_number')
        if pan:
            pan = pan.upper().replace(' ', '')
            
            if len(pan) != 10:
                raise ValidationError("PAN must be exactly 10 characters.")
            
            # Format: 5 letters + 4 digits + 1 letter
            if not (pan[:5].isalpha() and pan[5:9].isdigit() and pan[9].isalpha()):
                raise ValidationError("Invalid PAN format. Expected: 5 letters + 4 digits + 1 letter (e.g., ABCDE1234F)")
        
        return pan

    def clean_upi_id(self):
        """Validate UPI ID format"""
        upi_id = self.cleaned_data.get('upi_id')
        if upi_id:
            if '@' not in upi_id:
                raise ValidationError("UPI ID must be in format: username@bankname (e.g., yourname@okhdfcbank)")
            
            parts = upi_id.split('@')
            if len(parts) != 2 or not parts[0] or not parts[1]:
                raise ValidationError("Invalid UPI ID format.")
        
        return upi_id

    def clean(self):
        """Overall form validation"""
        cleaned_data = super().clean()
        
        # At least one payment method must be filled
        account_number = cleaned_data.get('account_number')
        upi_id = cleaned_data.get('upi_id')
        
        if not account_number and not upi_id:
            raise ValidationError(
                "Please provide either a Bank Account Number or UPI ID for receiving payouts."
            )
        
        return cleaned_data


# ============================================================================
# AFFILIATE WITHDRAWAL REQUEST FORM
# ============================================================================

class AffiliateWithdrawalForm(forms.Form):
    """Form for requesting affiliate withdrawals"""
    
    PAYMENT_METHOD_CHOICES = [
        ('bank', '🏦 Bank Transfer'),
        ('upi', '📱 UPI Transfer'),
    ]
    
    amount = forms.DecimalField(
        label="Withdrawal Amount (₹)",
        max_digits=15,
        decimal_places=2,
        min_value=1000,
        widget=forms.NumberInput(attrs={
            'class': 'form-control',
            'placeholder': 'Minimum ₹1000',
            'step': '100'
        }),
        help_text="Minimum withdrawal: ₹1000"
    )
    
    payment_method = forms.ChoiceField(
        label="Payment Method",
        choices=PAYMENT_METHOD_CHOICES,
        widget=forms.RadioSelect(attrs={
            'class': 'form-check-input'
        })
    )
    
    # Bank Transfer Fields
    bank_name = forms.CharField(
        label="Bank Name",
        max_length=100,
        required=False,
        widget=forms.TextInput(attrs={
            'class': 'form-control',
            'placeholder': 'e.g., HDFC Bank',
        })
    )
    
    account_holder_name = forms.CharField(
        label="Account Holder Name",
        max_length=200,
        required=False,
        widget=forms.TextInput(attrs={
            'class': 'form-control',
            'placeholder': 'Name as per bank account',
        })
    )
    
    account_number = forms.CharField(
        label="Account Number",
        max_length=20,
        required=False,
        widget=forms.TextInput(attrs={
            'class': 'form-control',
            'placeholder': 'e.g., 1234567890',
        })
    )
    
    ifsc_code = forms.CharField(
        label="IFSC Code",
        max_length=11,
        required=False,
        widget=forms.TextInput(attrs={
            'class': 'form-control',
            'placeholder': 'e.g., HDFC0000001',
        })
    )
    
    # UPI Field
    upi_id = forms.CharField(
        label="UPI ID",
        max_length=255,
        required=False,
        widget=forms.TextInput(attrs={
            'class': 'form-control',
            'placeholder': 'yourname@okhdfcbank',
        })
    )
    
    # Additional info
    notes = forms.CharField(
        label="Special Instructions (Optional)",
        max_length=500,
        required=False,
        widget=forms.Textarea(attrs={
            'class': 'form-control',
            'placeholder': 'Any special notes for payment processing...',
            'rows': 3
        })
    )

    def clean(self):
        """Validate withdrawal request"""
        cleaned_data = super().clean()
        payment_method = cleaned_data.get('payment_method')
        amount = cleaned_data.get('amount')
        
        # Validate amount
        if amount and amount < 1000:
            raise ValidationError("Minimum withdrawal amount is ₹1000.")
        
        # Validate payment method details
        if payment_method == 'bank':
            bank_name = cleaned_data.get('bank_name', '').strip()
            account_holder = cleaned_data.get('account_holder_name', '').strip()
            account_number = cleaned_data.get('account_number', '').strip()
            ifsc_code = cleaned_data.get('ifsc_code', '').strip()
            
            if not all([bank_name, account_holder, account_number, ifsc_code]):
                raise ValidationError(
                    "Please provide all bank details (Bank Name, Account Holder Name, Account Number, IFSC Code) for bank transfer."
                )
        
        elif payment_method == 'upi':
            upi_id = cleaned_data.get('upi_id', '').strip()
            if not upi_id:
                raise ValidationError("Please provide your UPI ID for UPI transfer.")
            
            if '@' not in upi_id:
                raise ValidationError("Invalid UPI ID format. Use: username@bankname")
        
        return cleaned_data


